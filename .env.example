# ============================================
# 配置模板：复制为 .env 后按需填写
#   Windows: copy .env.example .env    /    Linux、macOS: cp .env.example .env
#
# 分层（2026-11-05 校准，见 agent/config_load.py）：
#   config.yaml        纯结构骨架，只写 ${VAR} / ${VAR:-默认值}
#   model_registry.txt 全部模型清单（进 git；自动下线在这里加 #）
#   .env               端点 / KEY / 调参（保密，.gitignore 忽略，永不提交）
#   本模板只列变量名与口径，允许提交：密钥类值一律留空；参数类给出的是
#   config.yaml 的默认值示例，照抄或不填都行。
#
#   · 每个变量行都是注释状态（行首 #）：去掉要用的那几行的 # 再填值。
#     别留成「KEY=」空串 —— 空串会顶掉 config.yaml 的 :-默认值：数值项退化成
#     "警告 + 默认值"，端点项变成空 base_url，该站直接被标 broken。
#   · 模型清单**不在这里**：NODE_*_MODELS 由 model_registry.txt 维护。写进 .env
#     会**盖住** registry 的 git 更新与自动下线（.env 是后加载的、优先级更高），
#     启动时会在 stderr 按配置分层点名告警。
#   · 端点/KEY 为空不用改代码：该站在 health 里以 broken 呈现、不参与派工，
#     不必去删 config.yaml 的 agents 条目。变量名填错不报错，只会让 ${VAR}
#     插值为空；改完重启外壳（bridge / mcp / call），看 stderr 的 [配置警告]
#     确认是否生效。
#
# 优先级：shell 预置变量 > .env > model_registry.txt > config.yaml 的 :-默认值。
#   只有带 :-默认值的参数类能"不填"；端点/KEY 类没有默认值，不填就是空凭据。
# ============================================

# ---------- 中转站 A/B：任意 OpenAI 兼容端点 ----------
# base_url 写完整地址（含 /v1），Key 是该站的 API Key；两站的公开端点示例见
# README.md 的配置示例。想启用 node-a 就必须填这两行，node-b 同理。
# node-b（kilo 网关）接了免费节点自动发现，开关在下方 collaboration 段。
#NODE_A_ENDPOINT=
#NODE_A_KEY=
#NODE_B_ENDPOINT=
#NODE_B_KEY=

# ---------- 免费档站点 C：Google Gemini ----------
# base_url 已硬编码在 config.yaml（generativelanguage.googleapis.com/v1beta/openai/），
# 所以这里**只需要 Key**。模型清单见 model_registry.txt 的站点 C 段。
# 新建 / 管理 Key（登录 Google AI Studio）：https://aistudio.google.com/apikey
# 官方 Key 文档：https://aistudio.google.com/docs/api-key
# 口径提醒：2026-05-28 起 AI Studio 新建的 Key 默认是 auth key（绑定服务账号、
#   默认只限 Generative Language API）；若调用报权限错，到 Dashboard → Projects
#   确认 Google Cloud 项目与 IAM 权限。免费档配额以控制台实时显示为准。
#GEMINI_API_KEY=

# ---------- 免费档站点 D：Cloudflare Workers AI ----------
# 两项都要填：CF_API_TOKEN 是 API Token，CF_BASE_URL 是 OpenAI 兼容端点。
# 新建 / 管理 Token（登录 Dashboard）：https://dash.cloudflare.com/profile/api-tokens
#   用 "Workers AI" 模板最省事；手工建 Custom Token 要同时给
#   Workers AI - Read 和 Workers AI - Edit（只给 AI Gateway 权限会 401）。
# OpenAI 兼容端点文档：
#   https://developers.cloudflare.com/workers-ai/configuration/open-ai-compatibility/
# CF_BASE_URL 的固定格式（把 <Account_ID> 换成自己的）：
#   https://api.cloudflare.com/client/v4/accounts/<Account_ID>/ai/v1
# 结尾只到 /ai/v1，别带 /chat/completions（程序自己拼）。Account_ID 在登录
# Dashboard 后的地址栏里，或 Workers AI → Use REST API 页面可见。
# 模型清单见 model_registry.txt 站点 D 段（模型名自带 @cf/ 前缀）。
#CF_BASE_URL=
#CF_API_TOKEN=

# ---------- LLM 调用参数（config.yaml 的 llm: 段，只剩这两项被代码读取）----------
# 单请求超时秒数；整体限时按站感知批次数 × 整条回退链最坏墙钟 + 30s 折算
#LLM_TIMEOUT=120
# 限流(429)/超时/5xx/连接失败的最大重试次数（指数退避；认证与其余 4xx 不重试）
#LLM_MAX_RETRIES=2

# ---------- 协作策略（collaboration.*，注释里是 config.yaml 的默认值）----------
# 省 token 开关：true=主在派工协作时优先省自己的 token（MAO 只透传，不自行判断模式）
#COLLAB_ECONOMY=false
# 全局并发上限：同时在飞的派工请求数
#COLLAB_MAX_WORKERS=3
# 同一中转站同时允许几个在飞请求（1 = 一站只跑一个模型，跨站才真并行）
#COLLAB_MAX_PER_STATION=1
# 单次派工最多拉几个工人（参与人数上限，防"池大 + 限时短"把尾部批次判未完成丢掉）
#COLLAB_MAX_PARTICIPANTS=5
# 达成共识所需的有效票比例
#COLLAB_VOTE_THRESHOLD=0.5
# 投票阶段每个候选给投票人看的预览长度（字符，40~2000，默认 240）
#COLLAB_VOTE_PREVIEW_CHARS=240
# 连续失败几次进入冷却 / 冷却基数秒（指数退避 base × 2^n）
#COLLAB_COOLDOWN_FAILS=2
#COLLAB_COOLDOWN_BASE=10
# 冷却封顶秒数
#COLLAB_COOLDOWN_MAX=3600
# 单模型可重试失败后最多回退几个额外模型（0=关闭回退）
#COLLAB_FALLBACK_MODELS=2
# 同站无可用候选时是否允许跨站回退
#COLLAB_FALLBACK_CROSS_STATION=true
# 当日失败隔离 + 连续运行日失败自动下线：档案路径 / 连击天数
#COLLAB_HEALTH_FILE=data/model_health.json
#COLLAB_RETIRE_DAYS=7
# 延迟档案：路径 / 是否自动探测 / 周期 / 探测短超时 / 裁剪比例 / 冷启动最小样本数
#COLLAB_LATENCY_FILE=data/model_latency.json
#COLLAB_LATENCY_PROBE=true
#COLLAB_LATENCY_PROBE_INTERVAL=600
#COLLAB_LATENCY_PROBE_TIMEOUT=8
# 探测请求的输出上限（token，0=不带；网关不认该参数时探测自动按站降级）
#COLLAB_LATENCY_PROBE_MAX_TOKENS=8
#COLLAB_LATENCY_KEEP_RATIO=0.6
#COLLAB_LATENCY_MIN_SAMPLES=2

# ---- 免费节点自动发现（见 agent/core/node_discovery.py；增量只写叠加层，不改 model_registry.txt）----
#COLLAB_FREE_NODE_DISCOVERY=true
#COLLAB_FREE_NODE_INTERVAL=86400
#COLLAB_FREE_NODE_TIMEOUT=10
#COLLAB_FREE_NODES_FILE=data/free_nodes.json

# ---------- 工具层 ----------
# 单条 shell 命令最长执行秒数
#TOOLS_SHELL_TIMEOUT=120
# 单次 MCP 工具调用的最长等待秒数（长事务型工具调大）
#TOOLS_MCP_TOOL_TIMEOUT=300

# ---------- 覆盖项（一般不填；测试 / 多实例隔离档案时才用）----------
# 这些是代码直接读 os.environ 的环境变量，**不经 config.yaml 插值**，优先级高于
# 上面同类的 COLLAB_* 项；只影响本机进程。
# 模型清单文件路径（默认仓库根的 model_registry.txt）
#MAO_MODEL_REGISTRY_FILE=model_registry.txt
# 健康 / 延迟档案路径：同一路径 = 同一本账（进程内共享实例，避免互相覆写丢记账）
#MAO_HEALTH_FILE=data/model_health.json
#MAO_LATENCY_FILE=data/model_latency.json
# 关掉自动延迟探测（填 0）：离线/CI 场景避免首个派工就起后台线程真打网络
#MAO_LATENCY_PROBE=0
# 关掉免费节点自动发现的联网抓取（0=不联网；已发现的叠加层仍照常套用）
#MAO_FREE_NODE_PROBE=0
# 叠加层路径（优先级高于 COLLAB_FREE_NODES_FILE，主要给测试/临时实例指到别处）
#MAO_FREE_NODES_FILE=data/free_nodes.json
