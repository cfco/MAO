# ============================================
# .env 示例 —— bynara 免费中转站直填版
# 用法：复制本文件为 .env，把标记"必填"的 KEY 填上真实 key 即可启动
#      （站点 A + 兜底用同一个 bynara key；站点 B 用 kilo 自己的 key，不用可留空）。
#   复制命令（PowerShell）：Copy-Item .env.example .env
# 变量名与 config.yaml 里的 ${...} 一一对应，填别的名字不生效。
# 注意：本文件按行 KEY=VALUE 解析，不支持行内注释（# 注释必须独占一行）。
# .env 属保密文件：.gitignore 永不提交，AI 约定不读取内容。
# ============================================

# ---------- 站点 A：router.bynara 免费中转（主站） ----------
NODE_A_ENDPOINT=https://router.bynara.id/v1

# 必填：把 bynara 的 key 粘贴到下一行等号后面（不要加引号/空格）
NODE_A_KEY=

# @数值 = 该模型上下文窗口（k 表示 ×1024）：256k=262144、512k=524288、1024k=1048576(1M)。
# 临时屏蔽某模型 = 在模型名前加 #（如 #laguna-s-2.1@256k），注释即下线不用删。
# 新增模型 = 按 "模型名@窗口" 逗号追加；网页里看到的模型名原样填即可。
NODE_A_MODELS=agnes-2.5-flash@512k,laguna-s-2.1@256k,ling-3.0-flash-fin-free@256k,ling-3.0-flash-sante-free@256k,ling-3.0-flash-vl-free@256k,nemotron-3-super-free@256k,nemotron-3-ultra-free@1024k,nemotron-3.5-lightning-free@1024k,nex-n2.5-pro@256k

# ---------- 站点 B：kilo.ai 网关（免费档 kilo-auto/free，256K 窗口） ----------
NODE_B_ENDPOINT=https://api.kilo.ai/api/gateway

# 必填：把 kilo.ai 的 key 粘贴到下一行等号后面（不用 kilo 就整段留空，自动忽略）
NODE_B_KEY=
NODE_B_MODELS=kilo-auto/free@256k

# ---------- 兜底单模型（solo 模式 / 池内节点全挂时用） ----------
# 把站点 A 同一个 key 再粘一次即可；LLM_MODEL 必须是上面模型列表里的一个。
LLM_ENDPOINT=https://router.bynara.id/v1
LLM_API_KEY=
LLM_MODEL=nex-n2.5-pro
