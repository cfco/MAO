# ============================================
# 配置模板：复制为 .env 后按需填写（cp .env.example .env）
#
#   · 本文件只列**变量名**与口径，值一律留空 —— 真实端点/KEY 只写在 .env 里。
#   · .env 已被 .gitignore 忽略，永不提交；本模板允许提交。
#   · 每一行都是**注释**状态（行首带 #）：去掉你要配置的那几行的 # 再填值。
#     不要留成 `KEY=`（空串）—— 空串会顶掉 config.yaml 里的 `:-默认值`，
#     数值项会退化成"警告 + 默认值"，端点项会变成空 base_url。
#   · 模型清单**不在这里**：NODE_*_MODELS 由 model_registry.txt 维护（随仓库走、
#     自动下线在那里加 #）。把清单写进 .env 会被那一层覆盖，别写。
#   · 变量名填错不会报错，只会让 config.yaml 的 ${VAR} 插值取不到值 —— 改完重启
#     外壳（bridge / mcp / call），看 stderr 的"[配置警告]"确认是否生效。
#
# 优先级（agent/config.py）：shell 预置变量 > .env > config.yaml 的 `:-默认值`。
# 下面每一项都**可以不填**，不填就走 config.yaml 的默认值。
# ============================================

# ---------- 中转站 A/B：任意 OpenAI 兼容端点（想启用 node-a 就必须填这两行）----------
# Endpoint 写完整 base_url（含 /v1），Key 是该站的 API Key。
#NODE_A_ENDPOINT=
#NODE_A_KEY=
#NODE_B_ENDPOINT=
#NODE_B_KEY=

# ---------- 免费档站点 C/D（不用就删掉 config.yaml 里对应的 agents 条目）----------
# Gemini：base_url 已硬编码在 config.yaml，只需 Key。
#GEMINI_API_KEY=
# Cloudflare Workers AI：OpenAI 兼容端点 + Token。
#CF_BASE_URL=
#CF_API_TOKEN=

# ---------- LLM 调用参数（config.yaml 的 llm: 段，只剩这两项被代码读取）----------
# 单请求超时秒数；ask_many/vote 的整体限时 = 批次数 × 本值 + 30s，重 prompt 要抬就改它
#LLM_TIMEOUT=120
# 限流(429)/超时/5xx/连接失败的最大重试次数（指数退避；认证与其余 4xx 不重试）
#LLM_MAX_RETRIES=2

# ---------- 协作策略（collaboration.*，注释里是 config.yaml 的默认值）----------
# 省 token 开关：true=主在派工协作时优先省自己的 token（MAO 只透传，不自行判断模式）
#COLLAB_ECONOMY=false
# 全局并发上限：同时在飞的派工请求数
#COLLAB_MAX_WORKERS=3
# 同一中转站同时允许几个在飞请求（1 = 一站只跑一个模型，跨站才真并行）
#COLLAB_MAX_PER_STATION=1
# 单次派工最多拉几个工人（参与人数上限，防"池大 + 限时短"把尾部批次判未完成丢掉）
#COLLAB_MAX_PARTICIPANTS=5
# 达成共识所需的有效票比例
#COLLAB_VOTE_THRESHOLD=0.5
# 连续失败几次进入冷却 / 冷却基数秒（指数退避 base × 2^n）
#COLLAB_COOLDOWN_FAILS=2
#COLLAB_COOLDOWN_BASE=10
# 冷却封顶秒数
#COLLAB_COOLDOWN_MAX=3600
# 单模型可重试失败后最多回退几个额外模型（0=关闭回退）
#COLLAB_FALLBACK_MODELS=2
# 同站无可用候选时是否允许跨站回退
#COLLAB_FALLBACK_CROSS_STATION=true
# 当日失败隔离 + 连续运行日失败自动下线：档案路径 / 连击天数
#COLLAB_HEALTH_FILE=data/model_health.json
#COLLAB_RETIRE_DAYS=7
# 延迟档案：路径 / 是否自动探测 / 周期 / 探测短超时 / 裁剪比例 / 冷启动最小样本数
#COLLAB_LATENCY_FILE=data/model_latency.json
#COLLAB_LATENCY_PROBE=true
#COLLAB_LATENCY_PROBE_INTERVAL=600
#COLLAB_LATENCY_PROBE_TIMEOUT=8
#COLLAB_LATENCY_KEEP_RATIO=0.6
#COLLAB_LATENCY_MIN_SAMPLES=2

# ---------- 工具层 ----------
# 单条 shell 命令最长执行秒数
#TOOLS_SHELL_TIMEOUT=120

# ---------- 覆盖项（一般不填，测试或多实例隔离档案时才用）----------
# 模型清单文件路径（默认仓库根的 model_registry.txt）
#MAO_MODEL_REGISTRY_FILE=model_registry.txt
# 健康 / 延迟档案路径：同一路径 = 同一本账（进程内共享实例，避免互相覆写丢记账）
#MAO_HEALTH_FILE=data/model_health.json
#MAO_LATENCY_FILE=data/model_latency.json
# 关掉自动延迟探测（填 0）：离线/CI 场景避免首个派工就起后台线程真打网络
#MAO_LATENCY_PROBE=0
