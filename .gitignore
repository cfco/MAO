# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 运行时产物
# 注意：.gitignore 不支持行内注释——`data/    # 说明` 会被当成一个字面 pattern，
# 规则等于失效（实测 data/ 未被忽略，会话历史 JSONL 会进提交）。注释必须独占一行。
data/
.uv/

# 测试/Lint 缓存（pytest、ruff 会各自写 .gitignore，这里显式声明以防被删）
.pytest_cache/
.ruff_cache/

# Secrets —— 绝不提交，防止推送到 GitHub 泄密
.env
.env.*
!.env.example

# Agent 本地工作记忆（个人运行时数据，与项目无关）
.workbuddy/

# 编辑器/IDE 本地配置
.idea/
.vscode/

# 系统垃圾
.DS_Store
Thumbs.db

# 临时/调试产物
.tmp_*
*.log

# uv 锁文件不强制（可提交让 CI 复现），这里保留让用户决定
# uv.lock  —— 如需精确复现依赖则提交；否则忽略

